# Self-Healing Enterprise RAG environment template
# Copy this file to `.env` and adjust values per environment.

# -----------------------------------------------------------------------------
# Core API / runtime
# -----------------------------------------------------------------------------
SHRAG_APP_NAME=self-healing-rag
SHRAG_APP_VERSION=0.2.0
SHRAG_DEBUG=false
SHRAG_DEFAULT_TENANT_ID=public
SHRAG_AUTH_REQUIRED=false
SHRAG_STATE_DB_PATH=.state/shrag.db

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
SHRAG_JWT_SECRET=change-me-in-prod
SHRAG_JWT_ALGORITHM=HS256
# SHRAG_JWT_ISSUER=
# SHRAG_JWT_AUDIENCE=
# SHRAG_JWKS_URL=

# -----------------------------------------------------------------------------
# Traffic controls
# -----------------------------------------------------------------------------
SHRAG_RATE_LIMIT_PER_MINUTE=120
SHRAG_MAX_INFLIGHT_REQUESTS=256
SHRAG_MAX_RETRIEVE_INFLIGHT=128
SHRAG_MAX_GRADE_INFLIGHT=128
SHRAG_MAX_GENERATE_INFLIGHT=64
SHRAG_MAX_REFLECT_INFLIGHT=64
SHRAG_MAX_HEAL_INFLIGHT=32
SHRAG_MAX_INGEST_INFLIGHT=32

# -----------------------------------------------------------------------------
# Storage / retrieval backends
# -----------------------------------------------------------------------------
SHRAG_VECTOR_BACKEND=sqlite
# SHRAG_QDRANT_URL=http://localhost:6333
SHRAG_QDRANT_COLLECTION=shrag_chunks
SHRAG_RATE_LIMIT_BACKEND=sqlite
# SHRAG_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Retrieval behavior
# -----------------------------------------------------------------------------
SHRAG_RETRIEVAL_DEFAULT_MODE=hybrid
SHRAG_RETRIEVAL_QUERY_SHAPE_ROUTING_ENABLED=false
SHRAG_RETRIEVAL_USE_DENSE_EMBEDDINGS=true
SHRAG_RETRIEVAL_DENSE_WEIGHT=0.6
SHRAG_RETRIEVAL_SPARSE_WEIGHT=0.4
SHRAG_RETRIEVAL_GRAPH_ENABLED=false
SHRAG_RETRIEVAL_WEB_FALLBACK_ENABLED=true

# -----------------------------------------------------------------------------
# Generation / guardrails
# -----------------------------------------------------------------------------
SHRAG_GENERATE_REQUIRE_EVIDENCE=true
SHRAG_LLM_BACKEND=mock
SHRAG_LLM_MODEL=default
SHRAG_LLM_TEMPERATURE=0.1
SHRAG_LLM_MAX_TOKENS=1024
SHRAG_LLM_FALLBACK_TO_MOCK=true
# SHRAG_OLLAMA_URL=http://localhost:11434
SHRAG_GUARD_MAX_QUERY_LEN=8000

# -----------------------------------------------------------------------------
# Chunking
# -----------------------------------------------------------------------------
SHRAG_CHUNK_TEMPLATE=naive
SHRAG_CHUNK_SIZE_WORDS=400
SHRAG_CHUNK_OVERLAP_WORDS=40

# -----------------------------------------------------------------------------
# Evaluation / release gates
# -----------------------------------------------------------------------------
SHRAG_EVAL_REGRESSION_MIN_QUALITY=0.55
SHRAG_EVAL_REGRESSION_MAX_ERROR_RATE=0.2
SHRAG_EVAL_CANARY_MIN_SAMPLE_SIZE=200
SHRAG_EVAL_CANARY_ROLLBACK_ERROR_RATE=0.02
SHRAG_RELEASE_REQUIRE_FINETUNE_REPORT=true
SHRAG_RELEASE_REQUIRE_LIVE_CONNECTOR_EVIDENCE=false

# -----------------------------------------------------------------------------
# Fine-tuning lane
# -----------------------------------------------------------------------------
SHRAG_FINETUNE_PROVENANCE_MODE=simulated
SHRAG_FINETUNE_METHOD=lora
SHRAG_FINETUNE_GPU_TYPE=NVIDIA-H100
SHRAG_FINETUNE_GPU_COUNT=1
SHRAG_FINETUNE_FRAMEWORK=pytorch
SHRAG_MODEL_REGISTRY_BACKEND=local_json
# SHRAG_MODEL_REGISTRY_HTTP_URL=https://model-registry.internal

# -----------------------------------------------------------------------------
# ERB benchmark harness
# -----------------------------------------------------------------------------
SHRAG_ERB_API_VERSION=2026-05-01
SHRAG_ERB_ROLES=writer
SHRAG_ERB_USER_ID=erb-bench-runner
SHRAG_ERB_TENANT_ID=erb-bench
